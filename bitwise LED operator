#include <stdio.h>

int main()
{
    unsigned char leds = 0x00;   // 00000000 (all OFF)

    printf("Initial LED Status: 0x%02X\n", leds);

    // Turn ON LED 0
    leds |= (1 << 0);
    printf("Turn ON LED 0: 0x%02X\n", leds);

    // Turn ON LED 3
    leds |= (1 << 3);
    printf("Turn ON LED 3: 0x%02X\n", leds);

    // Turn OFF LED 0
    leds &= ~(1 << 0);
    printf("Turn OFF LED 0: 0x%02X\n", leds);

    // Toggle LED 3
    leds ^= (1 << 3);
    printf("Toggle LED 3: 0x%02X\n", leds);

    return 0;
}
